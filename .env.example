# Licensed market-data source (single source only)
LSEG_BASE_URL=https://api.refinitiv.com
LSEG_TOKEN_URL=https://api.refinitiv.com/auth/oauth2/v2/token
LSEG_CLIENT_ID=
LSEG_CLIENT_SECRET=
LSEG_SCOPE=trapi

# Server
PORT=3000

# Fail-closed policy
MAX_EOD_AGE_HOURS=120
BACKTEST_MIN_YEARS=3
BACKTEST_MIN_TRADES=100
TRANSACTION_COST_BPS=60

# Optional: override ledger location
LEDGER_PATH=data/recommendations.ledger.jsonl
