# Copy to .env and fill these values on your private VPS.
EGX_DOMAIN=egx-ingest.example.org
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
EGX_UPLOAD_KEY=REPLACE_WITH_RANDOM_SECRET_LONGER_THAN_32_CHARACTERS
# OFF by default until the authoritative 1022 PDF URL is confirmed:
EGX_FETCH_ENABLED=false
EGX_OFFICIAL_REPORT_URL=
# Independent from Cairo server timezone; worker uses Africa/Cairo internally.
