{
  "schemaVersion": "17.1.0-long-history-config-1",
  "operatingMode": "LONG_HORIZON_RESEARCH",
  "yahooRange": "10y",
  "interval": "1d",
  "concurrency": 3,
  "timeoutMs": 30000,
  "maxAttempts": 2,
