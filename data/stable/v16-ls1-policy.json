{
  "schemaVersion": "16.9.2-ls1-policy-1",
  "modelId": "V16_9_LATE_SESSION_OPPORTUNITY_LS1",
  "version": "LS1_V1",
  "status": "TACTICAL_DECISION_SUPPORT",
  "methodologyFrozen": true,
  "automaticRetuneAllowed": false,
  "automaticOrderSubmission": false,
  "brokerExecutionAllowed": false,
  "productionV169MethodologyModified": false,
  "purpose": "Identify exceptional late-session opportunities that may be bought before the EGX close for the next trading session, without changing the frozen V16.9 final recommendation engine.",
  "timezone": "Africa/Cairo",
  "tradingDays": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday"],
  "session": {
    "marketOpenLocal": "10:00",
    "monitorUntilLocal": "13:54",
    "gateStartLocal": "13:55",
    "gateEndLocal": "14:09",
    "recheckStartLocal": "14:10",
    "recheckEndLocal": "14:21",
    "finalStartLocal": "14:22",
    "finalEndLocal": "14:29",
    "marketCloseLocal": "14:30"
  },
  "evidence": {
    "requireCurrentCairoDate": true,
    "requireSourceSessionDate": true,
    "minimumVerifiedSessionRows": 80,
    "minimumVerifiedSessionCoveragePct": 70,
    "maximumDataAgeMinutes": 20,
    "requireDailySeedMatchesLatestCompletedSession": true,
    "allowPublicDelayedData": true,
    "publicDelayedDataMustStillPassSessionEvidence": true
  },
  "candidateGates": {
    "allowedTiersForBuy": ["TIER_A_EXPERIMENTAL_PAPER"],
    "allowedStatesForBuy": ["ENTRY_ZONE", "BREAKOUT_CONFIRMED", "WATCH"],
    "blockedStates": ["STOP_BREACHED", "SUPPORT_BROKEN", "TARGET1_HIT", "TARGET2_HIT"],
    "minimumDecisionScore": 78,
    "minimumRecommendationScore": 82,
    "minimumRiskRewardFromCurrentPrice": 1.2,
    "minimumAverageTurnover20Egp": 5000000,
    "maximumPositiveSessionMovePct": 4.5,
    "minimumSessionMovePct": -2.5,
    "maximumAboveEntryHighPct": 1.25,
    "maximumBelowEntryLowPct": 0.75,
    "maximumSignals": 3,
    "minimumLs1Score": 80
  },
  "ranking": {
    "decisionScoreWeightPct": 35,
    "recommendationScoreWeightPct": 25,
    "riskRewardWeightPct": 20,
    "entryQualityWeightPct": 10,
    "liquidityQualityWeightPct": 10,
    "note": "Independent LS1 tactical ranking only. It does not alter V16.9 basket weights, thresholds, ranking, or post-close methodology."
  },
  "phaseRules": {
    "monitorMayCreateBuy": false,
    "gateMayCreateBuy": true,
    "recheckMayCreateNewBuy": false,
    "finalMayCreateNewBuy": false,
    "postCloseMayCreateBuy": false,
    "recheckCanConfirmOrCancelGateSignals": true,
    "finalCanConfirmOrCancelGateSignals": true
  },
  "labels": {
    "buy": "BUY_TODAY_FOR_NEXT_SESSION",
    "confirmed": "CONFIRMED_FOR_NEXT_SESSION",
    "wait": "WAIT",
    "cancel": "CANCEL",
    "noSignal": "NO_SIGNAL",
    "blocked": "SOURCE_EVIDENCE_BLOCKED"
  }
}
