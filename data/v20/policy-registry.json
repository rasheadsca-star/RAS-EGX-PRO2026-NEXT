{
  "schemaVersion": "20.0.0-policy-registry-4",
  "effectiveFrom": "2026-08-15",
  "status": "CONTROLLED_INTEGRATION",
  "principles": {
    "decisionSupportOnly": true,
    "v17FinalExecutionGateIsAuthoritative": true,
    "localRowExecutionFlagsCannotOverrideGlobalGate": true,
    "automaticPromotionForbidden": true,
    "automaticOrdersForbidden": true,
    "failedOrUnfilledAllocationRemainsCash": true
  },
  "executionGate": {
    "authoritativeSource": "data/v17/resilient-session-status.json",
    "requirements": {
      "executionGrade": true,
      "sessionAligned": true,
      "minimumCoveragePct": 95,
      "minimumFreshnessPct": 98,
      "liquidityGatePassed": true,
      "criticalSourceConflictCount": 0,
      "acceptableSourceConfidenceRequired": true
    },
    "researchBelowExecutionThresholds": "RESEARCH_ONLY",
    "note": "V20 never upgrades V17's final execution decision. These thresholds document the integration contract and may only make V20 more conservative."
  },
  "transactionCosts": {
    "roundTripPct": 0.6,
    "application": "ENTRY_NOTIONAL_CONSERVATIVE_ROUND_TRIP",
    "entryReference": "ENTRY_HIGH_FOR_LONGS",
    "netRewardFormula": "(target - entryReference) - transactionCostPerShare",
    "netRiskFormula": "(entryReference - stop) + transactionCostPerShare",
    "transactionCostPerShareFormula": "entryReference * roundTripPct / 100",
    "netRiskRewardFormula": "netReward / netRisk",
    "gatingEnabled": false,
    "gatingStatus": "PENDING_INDEPENDENT_CALIBRATION",
    "note": "Net R/R is displayed and regression-tested but does not silently alter the frozen Champion selection policy."
  },
  "technicalHistory": {
    "scope": "V20_CURRENT_OPPORTUNITY_UNIVERSE",
    "approvedPrimarySources": ["yahoo", "starta_ohlc_api"],
    "networkRefreshPreferred": true,
    "cachedHistoryFallbackAllowed": true,
    "missingOhlcSynthesisAllowed": false,
    "derivedSnapshotHistoryAllowed": false,
    "gitCommitDateAsMarketSessionAllowed": false,
    "futureRowsAllowed": false,
    "pointInTimeCutoffRequired": true,
    "currentReadiness": {
      "requiresLastHistorySessionEqualsV20Session": true,
      "requiresCurrentPriceReconciliation": true,
      "maximumCurrentPriceDifferencePct": 5,
      "requiresSma50Ready": true,
      "requiresMacdSignalReady": true
    },
    "indicatorMethodology": {
      "sma": "trusted closes only",
      "ema": "SMA seed then standard EMA multiplier",
      "rsi14": "Wilder smoothing",
      "atr14": "Wilder true range using trusted OHLC and prior close",
      "macd": "EMA12 minus EMA26 with EMA9 signal",
      "momentumHorizonsSessions": [5, 10, 20]
    },
    "productionExecutionGate": false,
    "staleIndicatorPolicy": "HISTORICAL_RESEARCH_CONTEXT_ONLY_NEVER_CURRENT_DECISION",
    "note": "Technical history can enrich explainability but cannot upgrade the authoritative V17 execution gate or silently change the frozen Champion policy."
  },
  "dataQuality": {
    "semanticCompletenessRequired": true,
    "nonPositiveCurrentPriceTreatedAsMissing": true,
    "nonPositiveOhlcTreatedAsMissing": true,
    "ohlcInvariantRequiredForCompleteState": true,
    "zeroVolumeMayRemainNumericWhenNonNegative": true,
    "currentPriceMayRemainAvailableWhenOhlcPartial": true,
    "globalV17CoverageMetricsRemainAuthoritative": true,
    "rowQualityMayOnlyDowngradeLocalTrust": true,
    "note": "Row-level semantic quality prevents zero or invalid OHLC values from being counted as complete. It never upgrades or rewrites V17's global gate metrics."
  },
  "userPortfolio": {
    "scope": "USER_OWNED_POSITIONS_ONLY",
    "storage": "BROWSER_LOCAL_STORAGE_ONLY",
    "storageKey": "egx-pro-v20-user-portfolio-v1",
    "serverPersistence": false,
    "repositoryPersistence": false,
    "influencesModelPortfolio": false,
    "influencesOpportunityRanking": false,
    "influencesChampion": false,
    "influencesExecutionGate": false,
    "automaticOrders": false,
    "automaticBuySellInstructions": false,
    "valuationRequiresCurrentSessionPrice": true,
    "stalePriceFallbackAllowed": false,
    "monitoringOutput": "MONITOR_OR_REVIEW_ONLY",
    "note": "User holdings are private browser-local inputs for P&L and risk monitoring. They are not a production allocation engine and cannot override V17 execution governance."
  },
  "portfolio": {
    "maximumTotalAllocationPct": 50,
    "maximumPositions": 4,
    "maximumSinglePositionPct": 12.5,
    "productionConstruction": "CHAMPION_COMPATIBLE_EQUAL_WEIGHT",
    "adaptiveWeightingProductionAllowed": false,
    "adaptiveWeightingShadowResearchAllowed": true,
    "riskStateExposureCapsPct": {
      "NORMAL": 50,
      "CAUTIOUS": 35,
      "DEFENSIVE": 20,
      "CASH_PRESERVATION": 0
    },
    "closedExecutionGateExposurePct": 0,
    "unfilledMemberPolicy": "KEEP_CASH",
    "sectorConcentrationPolicy": {
      "enforcedWhenVerifiedSectorDataAvailable": true,
      "currentFallback": "DO_NOT_INVENT_SECTOR_CLASSIFICATION",
      "status": "DATA_DEPENDENT"
    }
  },
  "tradePlan": {
    "direction": "LONG_ONLY_CURRENT_SCOPE",
    "entryReferenceForRiskMath": "ENTRY_HIGH",
    "sameDailyCandleTargetStopAmbiguity": "CONSERVATIVE_STOP_OR_AMBIGUOUS_IF_EXISTING_LEDGER_SUPPORTS_IT",
    "chaseForbidden": true,
    "nextOpenExecutionAssumptionAllowedOnlyWhenExplicitlyBacktested": true,
    "currentPriceAlignment": {
      "enabled": true,
      "warningDistancePct": 5,
      "hardReviewDistancePct": 20,
      "distanceFormula": "ABS(entryMidpoint-currentPrice)/currentPrice*100",
      "actionableRequiresCurrentPriceInsideEntryRange": true,
      "aboveEntryRangeAction": "FORCE_WAIT_DO_NOT_CHASE",
      "belowEntryRangeAction": "FORCE_WAIT_UNTIL_ENTRY_ZONE",
      "hardReviewAction": "FORCE_WAIT_REQUIRE_PLAN_REBUILD",
      "hardReviewCause": "PRICE_SCALE_OR_STALENESS_UNVERIFIED",
      "relationshipRequirements": {
        "long": "stop < entryLow <= entryHigh < target1"
      },
      "calibrationStatus": "OPERATIONAL_SANITY_GUARD_NOT_MODEL_EDGE_CALIBRATION",
      "note": "The 5% warning and 20% hard-review thresholds are defensive operational sanity checks. They do not claim model calibration and do not diagnose corporate actions, stale data, or price-scale changes without source evidence."
    }
  },
  "confidence": {
    "dimensions": [
      "marketConfidencePct",
      "dataConfidencePct",
      "modelConfidencePct",
      "executionConfidencePct"
    ],
    "doNotMixScoreAndConfidence": true,
    "executionConfidenceZeroWhenGlobalGateClosed": true
  },
  "governance": {
    "activeChampion": "V16_9_EQUAL_WEIGHT_BASKET",
    "championBranch": "release/v16.9.2-frozen-20260806",
    "v17Branch": "develop/v17-rebuild",
    "v19Branch": "v19-egx-chat-gpt",
    "integrationBranch": "develop/v20-integrated-decision-platform",
    "challengerAutomaticPromotion": false,
    "freshIndependentEvidenceRequiredForPromotionReview": true
  }
}
