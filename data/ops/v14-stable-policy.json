{
  "schemaVersion": "14.0.0",
  "releaseName": "V14.0 Stable Decision System",
  "releaseChannel": "stable-decision-support",
  "watchlist": {
    "count": 5,
    "tierOrder": ["STRICT_PAPER", "TIER_A_EXPERIMENTAL_PAPER", "TIER_B_PRIORITY_WATCH"],
    "descriptionAr": "تعرض أفضل خمسة أسهم تحت المراقبة دائمًا، حتى عندما لا توجد توصية شراء مؤهلة."
  },
  "noTradeGate": {
    "maximumQualifiedRecommendations": 3,
    "allowedTiers": ["STRICT_PAPER", "TIER_A_EXPERIMENTAL_PAPER"],
    "minimumTargetProbabilityPct": 45,
    "targetProbabilityMustExceedStopProbability": true,
    "minimumExpectedReturn5Pct": 0.25,
    "minimumRiskReward1": 1.25,
    "minimumEffectiveSample": 30,
    "minimumDistinctTrainingSessions": 10,
    "requireSufficientModel": true,
    "requireAcceptedMarketQuality": true,
    "requireExactFreshDegradedMinimum": true,
    "noTradeMessageAr": "لا توجد توصية شراء مؤهلة حاليًا. الاحتفاظ بالسيولة هو القرار الأفضل، مع استمرار متابعة أفضل خمسة أسهم."
  },
  "stabilityTargets": {
    "minimumResolvedSignals": 300,
    "minimumEnteredSignals": 100,
    "minimumIndependentSessions": 60,
    "minimumForwardSessions": 20,
    "strongForwardValidationSessions": 40
  },
  "evaluation": {
    "primaryHorizonSessions": 5,
    "displayHorizons": [1, 2, 3, 5, 10],
    "sameBarRule": "STOP_FIRST",
    "feesAndSlippageRequiredBeforeExecutionGrade": true
  },
  "execution": {
    "automaticBrokerOrders": false,
    "manualBrokerConfirmationRequired": true,
    "manualPriceVerificationRequired": true,
    "disappearingFromDailyWatchlistIsSellSignal": false
  },
  "featureFreeze": {
    "enabled": true,
    "messageAr": "تم تجميد الخصائص. أي تعديل جديد يجب أن يكون إصلاحًا للبيانات أو الاختبارات أو الاستقرار، وليس إضافة واجهات تجريبية جديدة."
  }
}
