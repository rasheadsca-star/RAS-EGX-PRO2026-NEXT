{
  "schemaVersion": "13.20.0",
  "name": "Multi-Session Purchase Priority Backtest & Continuous Results",
  "mode": "RESEARCH_SHADOW",
  "eligibility": {
    "allowedRecommendationTiers": ["STRICT_PAPER", "TIER_A_EXPERIMENTAL_PAPER"],
    "tierBMonitoringOnly": true,
    "strictBeforeTierA": true,
    "maximumRecommendations": 3,
    "requireValidPlan": true,
    "requireCurrentAlignedSession": true,
    "maximumHardFailureCount": 0
  },
  "evaluation": {
    "entryExpirySessions": 5,
    "horizons": [1, 2, 3, 5, 10],
    "primaryHorizonSessions": 5,
    "maximumHoldSessions": 10,
    "sameSessionStopAndTargetRule": "STOP_FIRST",
    "targetUsedForPriority": "TARGET1",
    "trackTarget2": true,
    "transactionCostR": 0.05
  },
  "probabilityModel": {
    "minimumResolvedTrainingSignals": 8,
    "minimumEnteredTrainingSignals": 5,
    "priorStrength": 8,
    "scoreBandwidth": 12,
    "riskRewardBandwidth": 0.75,
    "confidence": {
      "highEffectiveSample": 30,
      "mediumEffectiveSample": 15,
      "lowEffectiveSample": 5
    }
  },
  "safety": {
    "futureLeakageForbidden": true,
    "productionRankingChanged": false,
    "productionDecisionRulesChanged": false,
    "strategyRulesChanged": false,
    "automaticBrokerOrders": false,
    "manualBrokerConfirmationRequired": true,
    "recommendationsAreConditional": true,
    "probabilityIsHistoricalEstimateNotGuarantee": true
  }
}
