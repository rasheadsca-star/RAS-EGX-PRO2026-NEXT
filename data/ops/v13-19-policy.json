{
  "version": "13.19.0",
  "module": "RECOMMENDATION_HISTORY_PORTFOLIO_RISK_SYSTEM_HEALTH",
  "storage": {
    "scope": "LOCAL_DEVICE_ONLY",
    "recommendationHistoryKey": "egx-v1319-recommendation-history",
    "riskSettingsKey": "egx-v1319-risk-settings",
    "healthHistoryKey": "egx-v1319-health-history",
    "portfolioKey": "egx-v1318-portfolio-lifecycle",
    "uploadedToGitHub": false,
    "combinedBackupExportImport": true,
    "maximumRecommendationSessions": 180,
    "maximumHealthSnapshots": 50
  },
  "recommendationHistory": {
    "captureOnlyAlignedNonProvisionalSessions": true,
    "replaceCurrentSessionSnapshotInsteadOfDuplicating": true,
    "dailyChangeStates": [
      "NEW",
      "REMOVED",
      "UPGRADED",
      "DOWNGRADED",
      "RANK_UP",
      "RANK_DOWN",
      "DECISION_CHANGED",
      "UNCHANGED"
    ],
    "removalFromDailyRecommendationsClosesOpenPosition": false,
    "historyStartsFromFirstValidV13_19LoadOnDevice": true
  },
  "portfolioRisk": {
    "userDefinedCapital": true,
    "userDefinedRiskPerTradePct": true,
    "userDefinedMaximumPortfolioRiskPct": true,
    "userDefinedMaximumSectorExposurePct": true,
    "userDefinedMaximumOpenPositions": true,
    "requiresStopForDefinedRisk": true,
    "positionSizingBeforeFeesAndSlippage": true,
    "sectorExposureUsesAvailableClassification": true
  },
  "systemHealth": {
    "checksSessionAlignment": true,
    "checksExecutionGradeMarketData": true,
    "checksFallbackUsage": true,
    "checksExactFreshCoverage": true,
    "checksLaggedSymbolsBlocked": true,
    "states": [
      "HEALTHY",
      "LIMITED_SAFE",
      "BLOCKED"
    ],
    "localHealthHistoryIsNotGitHubActionsHistory": true
  },
  "safety": {
    "automaticBrokerOrders": false,
    "automaticBuySellExecution": false,
    "recommendationRemovalMeansAutomaticSell": false,
    "portfolioStatusIsBrokerInstruction": false,
    "stopPriceGuaranteedExecutionPrice": false,
    "riskCalculatorIsInvestmentRecommendation": false,
    "manualBrokerVerificationRequired": true
  },
  "productionCore": {
    "engineVersion": "13.17.1",
    "strategyRulesChanged": false,
    "rankingRulesChanged": false,
    "evidenceGatesChanged": false,
    "canonicalWorkflow": ".github/workflows/v13-17-1-exact-fresh-production-universe.yml",
    "reapplyMarker": "V13_19_RECOMMENDATION_RISK_HEALTH_REAPPLY"
  }
}
