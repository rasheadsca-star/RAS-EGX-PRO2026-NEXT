# EGX PRO central-DB storage (Cloudflare R2). NAMES ONLY - never commit values. In GitHub: Settings > Secrets and variables > Actions.
# --- Secrets ---
EGX_STORE_BUCKET=egx-pro-central-db
EGX_STORE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
EGX_STORE_ACCESS_KEY_ID=            # R2 API token scoped to THIS bucket only (Object Read & Write); maps to AWS_ACCESS_KEY_ID
EGX_STORE_SECRET_ACCESS_KEY=        # maps to AWS_SECRET_ACCESS_KEY
# --- Variables (optional; may only LOWER the built-in limits) ---
EGX_STORE_PREFIX=egx-central
EGX_STORE_LIMIT_BYTES=3000000000    # default 3 GB;  hard ceiling in code 5 GB  (free tier 10 GB-month)
EGX_STORE_LIMIT_CLASS_A=100000      # default 100k/month; ceiling 500k (free tier 1M)   put/list
EGX_STORE_LIMIT_CLASS_B=1000000     # default 1M/month;   ceiling 5M   (free tier 10M)  head/get
# --- Gates (the workflow refuses to run unless BOTH are 'true') ---
DECISION_ROOM_ENABLED=false
STORAGE_OWNER_APPROVED=false        # set true only after reading docs/STORAGE_COST_RISK.md
