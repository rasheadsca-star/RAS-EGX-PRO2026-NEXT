    { "source": "/analyze", "destination": "/api/index?route=analyze" },
    { "source": "/simulate", "destination": "/api/index?route=simulate" },
    { "source": "/decision-log", "destination": "/api/index?route=decision-log" },
    { "source": "/ablation", "destination": "/api/index?route=ablation" },
